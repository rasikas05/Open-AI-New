# Spring Boot does not load this file automatically.
# Set these as OS / IDE environment variables before starting the app.
# Copy names only — never put real secrets in Git.

# Default (local) profile AND prod both require DB credentials from env.
# Do NOT set SPRING_PROFILES_ACTIVE=prod for normal IntelliJ local runs.
# Prod EC2: SPRING_PROFILES_ACTIVE=prod
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost

# REQUIRED for current default (llm.provider=bedrock in application.properties / application-prod.properties).
# Set this in IntelliJ Run Configuration → Environment variables (this file is not auto-loaded).
BEDROCK_API_KEY=your-bedrock-api-key-here
# Rollback only — when you set llm.provider=openai
OPENAI_API_KEY=your-openai-key-here
PRESIDIO_API_KEY=your-presidio-key-here
RAG_INTERNAL_API_KEY=your-rag-internal-api-key-here

# Optional Lex overrides (defaults exist in properties if unset)
# LEX_BOT_ID=your-lex-bot-id
# LEX_BOT_ALIAS_ID=your-lex-bot-alias-id

# Cognito client_secret is NOT used by Spring (JWT via issuer/JWKS).
# Keep COGNITO_CLIENT_ID / COGNITO_CLIENT_SECRET in Postman for token minting only.
